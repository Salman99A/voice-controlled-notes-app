<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:colorBackground">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:titleTextColor="?attr/colorOnBackground" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="100dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="12dp">

            <!-- Note Type Selector (Regular Note vs To-Do Task) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:text="Type: "
                    android:textColor="@color/primary_light"
                    android:textSize="13sp" />

                <RadioGroup
                    android:id="@+id/rgNoteType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rbTypeNote"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/primary"
                        android:checked="true"
                        android:fontFamily="sans-serif-medium"
                        android:text="Regular Note"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="13sp" />

                    <RadioButton
                        android:id="@+id/rbTypeTodo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:buttonTint="@color/primary"
                        android:fontFamily="sans-serif-medium"
                        android:text="To-Do Task"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="13sp" />
                </RadioGroup>
            </LinearLayout>

            <!-- Category Selector & Reminder Badges -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Spinner
                    android:id="@+id/spinnerCategory"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_chip_unselected"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <!-- Set Reminder Action Chip -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSetReminder"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/btn_set_reminder"
                    android:textColor="@color/accent"
                    android:textSize="12sp"
                    app:cornerRadius="19dp"
                    app:icon="@drawable/ic_alarm"
                    app:iconSize="16dp"
                    app:iconTint="@color/accent"
                    app:strokeColor="@color/accent"
                    app:strokeWidth="1dp" />
            </LinearLayout>

            <!-- Repeat Reminder Interval Selector (for To-Dos) -->
            <LinearLayout
                android:id="@+id/layoutRepeatInterval"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="Repeat: "
                    android:textColor="@color/accent"
                    android:textSize="13sp" />

                <Spinner
                    android:id="@+id/spinnerRepeatInterval"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_chip_unselected"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp" />
            </LinearLayout>

            <!-- Active Reminder Bar if set -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardActiveReminder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/surface_dark"
                app:cardCornerRadius="12dp"
                app:strokeColor="@color/accent"
                app:strokeWidth="1dp"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="8dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_alarm"
                        app:tint="@color/accent" />

                    <TextView
                        android:id="@+id/tvActiveReminderTime"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/accent"
                        android:textSize="13sp"
                        tools:text="Reminder: Tomorrow, 10:00 AM" />

                    <ImageView
                        android:id="@+id/btnRemoveReminder"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/btn_remove_reminder"
                        android:padding="4dp"
                        android:src="@drawable/ic_clear"
                        app:tint="@color/status_red" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Note Title Field -->
            <EditText
                android:id="@+id/etNoteTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@android:color/transparent"
                android:fontFamily="sans-serif-black"
                android:hint="@string/hint_note_title"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLines="3"
                android:textColor="?attr/colorOnBackground"
                android:textColorHint="?android:attr/textColorHint"
                android:textSize="24sp" />

            <!-- Last Modified Date Indicator -->
            <TextView
                android:id="@+id/tvEditModifiedDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif"
                android:textColor="?android:attr/textColorHint"
                android:textSize="12sp"
                tools:text="Edited: Today, 9:45 AM | 42 words" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="16dp"
                android:background="@color/divider_dark" />

            <!-- Note Content Field -->
            <EditText
                android:id="@+id/etNoteContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:fontFamily="sans-serif"
                android:gravity="top|start"
                android:hint="@string/hint_note_content"
                android:inputType="textCapSentences|textMultiLine"
                android:lineSpacingExtra="6dp"
                android:minLines="12"
                android:textColor="?attr/colorOnSurface"
                android:textColorHint="?android:attr/textColorHint"
                android:textSize="16sp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Action Bar (Dictate + Save) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="?android:colorBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <!-- Dictate Mic Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDictate"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:text="@string/mic_tap_to_speak"
            android:textColor="@color/primary_light"
            app:cornerRadius="25dp"
            app:icon="@drawable/ic_mic"
            app:iconSize="20dp"
            app:iconTint="@color/primary_light"
            app:strokeColor="@color/primary_light"
            app:strokeWidth="1.5dp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Save Button -->
        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/btnSaveNote"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_save"
            android:textColor="@color/white"
            app:backgroundTint="@color/primary"
            app:icon="@drawable/ic_save"
            app:iconTint="@color/white" />
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
