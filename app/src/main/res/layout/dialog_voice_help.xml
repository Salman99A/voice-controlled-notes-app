<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/colorSurface"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-black"
        android:text="@string/title_voice_commands"
        android:textColor="?attr/colorOnSurface"
        android:textSize="20sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="sans-serif"
        android:text="Speak naturally. Here are sample voice commands:"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="13sp" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:layout_marginTop="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Note Creation Commands -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:text="📝 Note Creation"
                android:textColor="@color/primary_light"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingExtra="3dp"
                android:text="• 'Create a note'\n• 'New note titled Project Ideas'\n• 'Add buy milk to my notes'"
                android:textColor="?attr/colorOnSurface"
                android:textSize="13sp" />

            <!-- Search Commands -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="sans-serif-bold"
                android:text="🔍 Search"
                android:textColor="@color/primary_light"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingExtra="3dp"
                android:text="• 'Search for Java'\n• 'Find notes about meetings'\n• 'Search notes'"
                android:textColor="?attr/colorOnSurface"
                android:textSize="13sp" />

            <!-- Text to Speech Commands -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="sans-serif-bold"
                android:text="🔊 Read Aloud (TTS)"
                android:textColor="@color/primary_light"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingExtra="3dp"
                android:text="• 'Read my latest note'\n• 'Read all notes'\n• 'Read this note'"
                android:textColor="?attr/colorOnSurface"
                android:textSize="13sp" />

            <!-- Reminder Commands -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="sans-serif-bold"
                android:text="⏰ Reminders"
                android:textColor="@color/primary_light"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingExtra="3dp"
                android:text="• 'Set a reminder for tomorrow at 10 AM'\n• 'Remind me at 5 PM'"
                android:textColor="?attr/colorOnSurface"
                android:textSize="13sp" />

            <!-- Theme & Navigation Commands -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="sans-serif-bold"
                android:text="🎨 Theme &amp; Navigation"
                android:textColor="@color/primary_light"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingExtra="3dp"
                android:text="• 'Turn on dark mode' / 'Enable light mode'\n• 'Open settings'\n• 'Go home' / 'Go back'\n• 'Delete note titled Project Ideas'"
                android:textColor="?attr/colorOnSurface"
                android:textSize="13sp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnGotIt"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:text="Got it"
        android:textColor="@color/white"
        app:backgroundTint="@color/primary"
        app:cornerRadius="24dp" />

</LinearLayout>
