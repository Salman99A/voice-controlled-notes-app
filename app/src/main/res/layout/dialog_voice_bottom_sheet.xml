<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/colorSurface"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="16dp"
    android:paddingBottom="28dp">

    <!-- Top Drag Handle Indicator -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_chip_unselected" />

    <!-- State Header Title -->
    <TextView
        android:id="@+id/tvVoiceSheetState"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-bold"
        android:text="@string/mic_listening"
        android:textColor="?attr/colorOnSurface"
        android:textSize="20sp" />

    <!-- Interactive Pulsing Mic & Soundwave Visualizer Bars -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:layout_marginTop="16dp">

        <LinearLayout
            android:id="@+id/layoutSoundWave"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="horizontal">

            <View
                android:id="@+id/waveBar1"
                android:layout_width="6dp"
                android:layout_height="24dp"
                android:layout_marginHorizontal="3dp"
                android:background="@drawable/bg_soundwave_bar" />

            <View
                android:id="@+id/waveBar2"
                android:layout_width="6dp"
                android:layout_height="40dp"
                android:layout_marginHorizontal="3dp"
                android:background="@drawable/bg_soundwave_bar" />

            <View
                android:id="@+id/waveBar3"
                android:layout_width="6dp"
                android:layout_height="64dp"
                android:layout_marginHorizontal="3dp"
                android:background="@drawable/bg_soundwave_bar" />

            <!-- Center Mic Icon -->
            <ImageView
                android:id="@+id/ivSheetMicIcon"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginHorizontal="12dp"
                android:background="@drawable/bg_mic_hero"
                android:contentDescription="@null"
                android:padding="14dp"
                android:src="@drawable/ic_mic"
                app:tint="@color/white" />

            <View
                android:id="@+id/waveBar4"
                android:layout_width="6dp"
                android:layout_height="64dp"
                android:layout_marginHorizontal="3dp"
                android:background="@drawable/bg_soundwave_bar" />

            <View
                android:id="@+id/waveBar5"
                android:layout_width="6dp"
                android:layout_height="40dp"
                android:layout_marginHorizontal="3dp"
                android:background="@drawable/bg_soundwave_bar" />

            <View
                android:id="@+id/waveBar6"
                android:layout_width="6dp"
                android:layout_height="24dp"
                android:layout_marginHorizontal="3dp"
                android:background="@drawable/bg_soundwave_bar" />

        </LinearLayout>
    </FrameLayout>

    <!-- Detected Command Intent Chip (e.g. Command: CREATE_NOTE | Title: "Project Ideas") -->
    <TextView
        android:id="@+id/tvDetectedCommand"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_chip_selected"
        android:fontFamily="sans-serif-bold"
        android:paddingHorizontal="14dp"
        android:paddingVertical="5dp"
        android:textColor="@color/white"
        android:textSize="12sp"
        android:visibility="gone"
        tools:text="Command: Create Note • 'Project Plan'"
        tools:visibility="visible" />

    <!-- Live Transcribed Text Box -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        app:cardBackgroundColor="@color/surface_variant_dark"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/card_border_dark"
        app:strokeWidth="1dp">

        <TextView
            android:id="@+id/tvTranscribedResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:minLines="3"
            android:padding="16dp"
            android:text="@string/mic_say_something"
            android:textColor="?attr/colorOnSurface"
            android:textSize="15sp"
            tools:text="Create a note titled Final Year Project and add requirements." />
    </com.google.android.material.card.MaterialCardView>

    <!-- Action Buttons Row -->
    <LinearLayout
        android:id="@+id/layoutActionButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSheetCancel"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:text="@string/btn_cancel"
            android:textColor="?attr/colorOnSurface"
            app:cornerRadius="25dp"
            app:strokeColor="@color/card_border_dark" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSheetAction"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1.2"
            android:text="@string/voice_action_save_note"
            android:textColor="@color/white"
            app:backgroundTint="@color/primary"
            app:cornerRadius="25dp" />
    </LinearLayout>

</LinearLayout>
